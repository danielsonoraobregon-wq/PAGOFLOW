# ─── WhatsApp Business API (360dialog o Meta directo) ─────────────────────────
WA_TOKEN=tu_token_de_whatsapp_aqui
WA_PHONE_NUMBER_ID=tu_phone_number_id
WA_VERIFY_TOKEN=pagoflow_secret_cambia_esto

# ─── Tu número de WhatsApp para recibir alertas ────────────────────────────────
# Formato internacional sin + : 528112345678
MY_PHONE=528112345678

# ─── Anthropic (IA para leer comprobantes) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Drive ─────────────────────────────────────────────────────────────
# Pega aquí el JSON completo de tu cuenta de servicio (en una sola línea)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ID de la carpeta "Lotes" que compartiste con la cuenta de servicio
# Lo encuentras en la URL de Drive: drive.google.com/drive/folders/ESTE_ID
DRIVE_ROOT_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ

# ─── Opciones ─────────────────────────────────────────────────────────────────
# true = manda confirmación por WA cuando se registra un pago (costo extra)
# false = solo guarda silenciosamente (más barato)
SEND_CONFIRMATIONS=true

# Ruta de la base de datos SQLite
DB_PATH=pagoflow.db
